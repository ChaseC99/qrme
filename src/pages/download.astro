---
import { Image } from "astro:assets";
import qrCodeView from "../images/views/qrcode_view.png";

import Layout from "../layouts/Layout.astro";
import { CAMPAIGN_IDS } from "../constants";
import DownloadBadge from "../components/DownloadBadge.astro";
import HoverQrCode from "../components/HoverQrCode.astro";
---

<Layout 
    title="QR Me | Download"
    pageDescription="Download for free on iOS and Android. Quickly and easily share your contact information with a QR Code."
    showNavbar={false}
    backgroundColor={"var(--color-app)"}
>
    <div class="header" data-hover-qr-region>
        <div class="header-text">
            <a href="/" class="header-title">
                <h1>QR Me - Contact</h1>
            </a>
            <div class="download-buttons" data-hover-qr-triggers>
                <DownloadBadge platform="ios" defaultSource={CAMPAIGN_IDS.DOWNLOAD_PAGE} />
                <DownloadBadge platform="android" defaultSource={CAMPAIGN_IDS.DOWNLOAD_PAGE} />
            </div>
            <div>
                <p>Download for free on iOS and Android!</p>
                <p>Quickly and easily share your contact information with a QR Code</p>
            </div>
        </div>
        <div class="screenshot-frame">
            <HoverQrCode>
                <Image
                    class="header-screenshot"
                    src={qrCodeView}
                    alt="Screenshot of QR Me Contact's homepage displaying a QR Code and a user's contact information"
                />
            </HoverQrCode>
        </div>
    </div>
</Layout>

<script>
    import { CAMPAIGN_IDS } from "../constants";
    import { getAttributionSource, getStoreUrl } from "../utils";

    // Wait for the page to load before redirecting to the store.
    window.addEventListener('load', () => {
        // Check if the user is on iOS or Android.
        const userAgent = navigator.userAgent;
        const isIOS = /iPad|iPhone|iPod/.test(userAgent) && !("MSStream" in window);
        const isAndroid = /Android/.test(userAgent);

        // Check if the user is coming from qrme.contact.
        const isFromQRMeContact = document.referrer.includes("qrme.contact");

        // Other desktop visitors stay on this page and can choose either store.
        if (!isAndroid && !isIOS && !isFromQRMeContact) return;

        // Default QR Me referrals to the App Store, whose listing looks better on desktop.
        const platform = isAndroid ? 'android' : 'ios';
        const source = getAttributionSource(CAMPAIGN_IDS.DOWNLOAD_PAGE);
        const storeUrl = getStoreUrl(platform, source);
        window.location.replace(storeUrl);
    });
</script>

<style>
    a {
        display: block;
    }

	.header {
        height: 100%;
        min-height: 100vh;
		margin: auto;
		display: flex;
		flex-direction: row;
		gap: 1em;
		justify-content: center;
        align-items: center;
	}

    .header-title {
        text-decoration: none; color: inherit;
    }

    .header-title h1 {
        font-size: clamp(1.25rem, 4vw, 2.5rem);
        white-space: nowrap;
    }

	.header-text {
        display: flex;
        flex-direction: column;
        gap: 1em;
		text-align: center;
		max-width: 400px;
        transform: translateY(-100px);
	}

	.header-text p {
		text-wrap: balance;
	}

	.screenshot-frame {
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 2em;
	}

	.header-screenshot {
		height: 70vh;
        width: auto;
		aspect-ratio: auto;
	}

    .download-buttons {
        display: flex;
        flex-direction: column;
        gap: 1em;
        justify-content: center;
        align-items: center;
    }

	@media only screen and (max-width: 500px) {
		header {
			height: auto;
		}

		.header {
			flex-direction: column;
			gap: 0px;
		}

        .header-title h1 {
            font-size: clamp(1.25rem, 8vw, 2rem);
        }

		.header-text {
			padding: 0;
			margin: auto;
            transform: translateY(0);
		}
	}
</style>
