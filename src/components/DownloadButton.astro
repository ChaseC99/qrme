---
import { CAMPAIGN_IDS, DESKTOP_QR_MEDIA } from "../constants";
import { getStoreUrl } from "../utils";
import DesktopDownloadButton from "./DesktopDownloadButton";
import "./DownloadButton.css";

// The App Store is the default because its listing is nicer; the script below
// switches Android visitors over once the user agent is known.
---

<div class="desktop-download">
    <DesktopDownloadButton client:media={DESKTOP_QR_MEDIA} />
</div>

<a
    class="download-button mobile-download"
    href={getStoreUrl('ios', CAMPAIGN_IDS.WEBSITE)}
    target="_blank"
    aria-label="Download on App Store"
    data-store-link="auto"
>
    Download
</a>

<script>
    // attributeStoreLinks picks the store for the href; the label has to follow it.
    if (/Android/.test(navigator.userAgent)) {
        document.querySelectorAll('a[data-store-link="auto"]')
            .forEach(link => link.setAttribute('aria-label', 'Download on Google Play'));
    }
</script>

<style>
    .desktop-download { display: none; }

    /* Matches DESKTOP_QR_MEDIA and the desktop QR generator. */
    @media (width > 900px) and (hover: hover) and (pointer: fine) and (not (any-pointer: coarse)) {
        .desktop-download { display: inline; }
        .mobile-download { display: none; }
    }
</style>
