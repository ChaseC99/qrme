---
import { CAMPAIGN_IDS } from "../constants";
import { getStoreUrl } from "../utils";

// The App Store is the default because its listing is nicer; the script below
// switches Android visitors over once the user agent is known.
---

<a
    class="download-button"
    href={getStoreUrl('ios', CAMPAIGN_IDS.WEBSITE)}
    target="_blank"
    aria-label="Download on App Store"
    data-store-link="auto"
>
    Download
</a>

<script>
    // attributeStoreLinks picks the store for the href; the label has to follow it.
    if (/Android/.test(navigator.userAgent)) {
        document.querySelectorAll('a[data-store-link="auto"]')
            .forEach(link => link.setAttribute('aria-label', 'Download on Google Play'));
    }
</script>

<style>
    .download-button {
        padding: 8px;
        text-decoration: none;
        background-color: var(--color-app);
        border-radius: 8px;
        color: black;
    }
</style>
