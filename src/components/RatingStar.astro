---
interface Props {
    filled?: number;
    size?: number;
    filledColor?: string;
    emptyColor?: string;
}

const {
    filled = 1,
    size = 18,
    filledColor = '#f5b400',
    emptyColor = '#e6e1d6',
} = Astro.props;

const normalizedFill = Math.min(1, Math.max(0, filled));
const emptyPercent = `${(1 - normalizedFill) * 100}%`;
const starPath = 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z';
---

<svg
    class="rating-star"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
>
    <path d={starPath} fill={emptyColor} />
    <path
        class="rating-star-fill"
        d={starPath}
        fill={filledColor}
        style={`clip-path: inset(0 ${emptyPercent} 0 0);`}
    />
</svg>

<style>
    .rating-star {
        display: block;
        flex: 0 0 auto;
    }
</style>
